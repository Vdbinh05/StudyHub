# ==============================================================================
# StudyHub V1.0 — Environment Variables Example
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local or any file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public Client Variables (exposed to the browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public canonical URL of the app (used for OAuth redirects, share links, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_, NEVER expose to client)
# ------------------------------------------------------------------------------
# Used ONLY in trusted server-side scripts / admin seed or background maintenance.
# Leave empty if not running server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Optional: Google OAuth (configured inside Supabase Dashboard -> Authentication
# -> Providers -> Google).
# Redirect URI to register in Google Cloud Console:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# App callback route handled by Next.js:
#   ${NEXT_PUBLIC_APP_URL}/auth/callback
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
